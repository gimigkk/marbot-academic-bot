# Dockerfile.prebuilt - For prebuilt binaries from GitHub Actions
# Runtime-only stage for prebuilt binary
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy prebuilt binary from build context
# This binary is built on GitHub Actions and transferred to VPS
COPY marbot-binary /app/marbot

# Copy application files
COPY migrations /app/migrations
COPY schedule.json /app/schedule.json

# Ensure binary is executable
RUN chmod +x /app/marbot

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

CMD ["/app/marbot"]