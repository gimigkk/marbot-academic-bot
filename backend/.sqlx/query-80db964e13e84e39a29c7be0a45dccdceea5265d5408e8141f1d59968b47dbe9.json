  "query": "\n        SELECT \n            a.id,\n            a.title,\n            a.parallel_codes,\n            c.name as course_name\n        FROM assignments a\n        JOIN courses c ON a.course_id = c.id\n        WHERE $1 = ANY(a.message_ids)\n        ",
