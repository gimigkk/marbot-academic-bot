{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            a.id, a.title, COALESCE(c.aliases[1], c.name) as \"course_name!\", a.deadline\n        FROM assignments a\n        JOIN courses c ON a.course_id = c.id\n        WHERE a.deadline > $1 \n          AND a.deadline <= $2 \n          AND a.reminder_1h_sent = FALSE\n        ",
